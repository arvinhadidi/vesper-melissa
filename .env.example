# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Melissa readings)
ANTHROPIC_API_KEY=

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY_GBP=
STRIPE_PRICE_ID_YEARLY_GBP=

# Analytics
# PostHog (product analytics + funnels). Get the Project API key from PostHog → Settings → Project.
# Leave blank locally to disable analytics entirely (track() becomes a no-op).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional — defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_HOST=
# Vercel Analytics needs no key — it's automatic when deployed on Vercel.
