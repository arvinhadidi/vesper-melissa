# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Melissa readings)
ANTHROPIC_API_KEY=

# Stripe (subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY_GBP=
STRIPE_PRICE_ID_YEARLY_GBP=

# Email (daily check-in)
RESEND_API_KEY=
# Any long random string — authenticates the Vercel cron hitting /api/cron/daily-checkin.
CRON_SECRET=
# Any long random string — keys the HMAC unsubscribe token in /api/email/unsubscribe.
EMAIL_UNSUBSCRIBE_SECRET=

# Analytics
# PostHog (product analytics + funnels). Get the Project API key from PostHog → Settings → Project.
# Leave blank locally to disable analytics entirely (track() becomes a no-op).
NEXT_PUBLIC_POSTHOG_KEY=
# Optional — defaults to https://us.i.posthog.com. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_HOST=
# Vercel Analytics needs no key — it's automatic when deployed on Vercel
