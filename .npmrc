# @vercel/analytics declares an OPTIONAL peer on @sveltejs/kit, whose own peer chain
# wants vite 8 — conflicting with the vite 5 that vitest pulls in. The optional peer is
# irrelevant to this Next.js app, so resolve peers leniently. Without this, a plain
# `npm install` (including on Vercel) fails with ERESOLVE.
legacy-peer-deps=true
