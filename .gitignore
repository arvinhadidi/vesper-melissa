# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright (storageState.json holds live session cookies — never commit)
/tests/e2e/storageState.json
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder template (no secrets) IS committed so the repo documents required vars
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand assets: only the final mascot images + backgrounds are committed
/brand_assets/brand_mascot/other_mascot_images/

# extracted font archive (font no longer used)
Faculty_Glyphic.zip
/public/fonts/

# raw tarot card source images (processed output lives in public/cards-cropped/)
/tarot-cards/

# standalone HTML (not part of Next.js app)
index.html

# local Claude settings
.claude/

# dev test page
/src/app/test/

# dev-only design scratchpad (not part of the live app — would ship as a public /main-preview route)
/src/app/main-preview/

# generated test artifacts (run logs / autonomous test plans — regenerated, not source)
/test-run-report.md
/manual-test-plan.json

# unused faded image variants
*-faded.png

# screenshots (generated, not source)
/screenshots/

env.txt
